# Offline build: reuses Linux node_modules + docker-cli/git from 1.7.0 base,
# overlays updated server code + host-built client dist.
# npm registry stays TLS-blocked here, but apk is reachable — so we harden the
# runtime image: patch OS packages and drop the global npm CLI + corepack, which
# are build tools never executed at runtime (CMD launches `node`, and the app
# only ever spawns the `git`/`docker` CLIs). This removes the CVE findings that
# live in the bundled npm toolchain (tar, pacote, sigstore, brace-expansion, …).
FROM swarm-dashboard:1.7.0
WORKDIR /app

# --- Security hardening (cached across code changes) ---
RUN apk update \
 && apk upgrade --no-cache --available \
 && rm -rf /usr/local/lib/node_modules/npm \
           /usr/local/lib/node_modules/corepack \
           /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
           /root/.npm /root/.cache /opt/yarn* /usr/local/bin/yarn /usr/local/bin/yarnpkg \
 && rm -rf /var/cache/apk/*

# Overlay pure-JS deps added/bumped since the 1.7.0 base image (npm registry is
# TLS-blocked, so these are staged from the host node_modules instead of installed):
#   node-forge  (new dependency used by server/src/pki.js)
#   nodemailer  (bumped 6.x -> 9.x; base image still has 6.9.15)
# Both are zero-dependency, platform-neutral JavaScript packages.
COPY build-deps/node-forge ./server/node_modules/node-forge
COPY build-deps/nodemailer ./server/node_modules/nodemailer

# Updated server source (remaining dependencies unchanged vs 1.7.0 -> reuse base node_modules)
COPY server/src ./server/src
COPY server/package.json ./server/package.json

# Freshly rebuilt client bundle (built on host: win32 toolchain, platform-neutral output)
COPY client/dist ./client/dist

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000
CMD ["node", "server/src/index.js"]
